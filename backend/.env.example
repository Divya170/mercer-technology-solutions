# NestJS API
PORT=4000
DATABASE_PATH=../database/app.sqlite
CORS_ORIGIN=http://localhost:3000
# Change in production!
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Seeded on first boot only (when no admin exists)
ADMIN_EMAIL=admin@mercertech.local
ADMIN_PASSWORD=MercerAdmin#2026
ADMIN_NAME=Holden Mercer

# Optional: email notification for each new enquiry.
# Leave SMTP_HOST empty to disable (admin shows "Not configured").
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM="Mercer Website <no-reply@example.com>"
# Recipient; defaults to the email in Admin → Settings when empty
NOTIFY_TO=
ADMIN_URL=http://localhost:3000/admin/leads

# How long enquiries are kept before they are due for deletion (days)
LEAD_RETENTION_DAYS=730
# Reject forms submitted faster than this after opening (ms) — bot check
MIN_FORM_FILL_MS=2500
